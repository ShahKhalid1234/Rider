rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if the user document exists and has matching UID
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if user is an admin
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Rides rules
    match /rides/{rideId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.riderId == request.auth.uid || 
        resource.data.status == 'searching' ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.riderId == request.auth.uid ||
        // Allow online available riders to accept 'searching' rides
        (resource.data.status == 'searching' && request.resource.data.riderId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Payments rules
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.riderId == request.auth.uid || 
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // Fare settings rules
    match /fareSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Service areas rules
    match /serviceAreas/{areaId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Support tickets rules
    match /supportTickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Notifications rules
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // Admin audit logs rules
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
